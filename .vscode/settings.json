{
  // Managed by the ketho.wow-api extension: on activation it strips any stale
  // ketho.wow-api entry and re-adds the current version's path, so the pinned version
  // here self-heals on update. Point at Annotations (the parent), NOT Annotations/Core —
  // Core alone omits FrameXML, which is where Settings, SlashCmdList, DEFAULT_CHAT_FRAME
  // and EditBox_ClearFocus are declared.
  //
  // Everything else lives in .luarc.json (editor-agnostic, and it takes precedence over
  // these settings anyway — a second copy here would only drift).
  "Lua.workspace.library": [
    "~/.vscode/extensions/ketho.wow-api-0.22.3/Annotations"
  ]
}
