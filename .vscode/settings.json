{
  // Send the ketho.wow-api extension's LuaLS writes to your USER settings instead of this file.
  // On every activation the extension rewrites Lua.runtime.version, Lua.runtime.builtin and
  // Lua.workspace.library into whichever scope this names — and it always writes the library as
  // Annotations/Core, which drops the FrameXML tree. At "Workspace" that means a tracked file
  // that churns on every editor start and disagrees with .luarc.json. At "User" the extension
  // deletes those keys from this file and never touches it again. .luarc.json supplies all
  // three settings and overrides the editor anyway, so nothing is lost.
  "wowAPI.luals.configurationScope": "User",

  // MUST stay false. When true (the default) the extension appends every WoW global it knows to
  // Lua.diagnostics.globals — hardcoded to WORKSPACE scope, so the setting above cannot redirect
  // it. Suppressing undefined-global throws away the only signal that a WoW API has been REMOVED;
  // an undefined global is nil at runtime, not an error. A ~45-name list grown this way hid the
  // removed GetItemStats for months.
  "wowAPI.luals.defineKnownGlobals": false
}
